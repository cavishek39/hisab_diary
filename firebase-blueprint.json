{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific settings and profile data.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "currency": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Account": {
      "title": "Financial Account",
      "description": "A bank account, investment, or cash wallet.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Bank", "Investment", "Cash", "Credit"] },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type", "balance"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "An expense, income, or transfer record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "accountId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["Expense", "Income", "Transfer"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "isAutomated": { "type": "boolean" },
        "originalSms": { "type": "string" },
        "targetAccountId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "accountId", "amount", "type", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and settings."
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Financial accounts."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions."
    }
  }
}
