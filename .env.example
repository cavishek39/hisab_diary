# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set as VITE_GEMINI_API_KEY for Vercel/direct Vite builds (VITE_ prefix required for client-side access).
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase configuration — find these in your Firebase project settings.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT_ID.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
# Optional: only needed if using a non-default Firestore database
VITE_FIREBASE_DATABASE_ID="(default)"

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"
